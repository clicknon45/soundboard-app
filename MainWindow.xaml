<Window x:Class="SoundboardApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Soundboard" Height="640" Width="900"
        Background="{StaticResource BgDark}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="TopBarButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SoundCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgPanel}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="6"/>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- Top bar: เลือกอุปกรณ์เสียง + ปุ่มเพิ่มเสียง -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BgPanel}" Padding="16,12">
            <StackPanel>
                <!-- แถวที่ 1: output device + ปุ่มควบคุมหลัก -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔊 Output Device:" Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                        <ComboBox x:Name="DeviceComboBox" Width="300"
                                  DisplayMemberPath="FriendlyName"
                                  SelectionChanged="DeviceComboBox_SelectionChanged"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="⏹ หยุดเสียงทั้งหมด" Style="{StaticResource TopBarButton}"
                            Background="#E05252" Margin="0,0,10,0" Click="StopAll_Click"/>

                    <Button Grid.Column="2" Content="➕ เพิ่มเสียง" Style="{StaticResource TopBarButton}"
                            Click="AddSound_Click"/>
                </Grid>

                <!-- แถวที่ 2: ผสมไมค์จริงเข้าไปในสตรีมเดียวกัน (แบบ Soundpad) -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox x:Name="MicEnabledCheckBox" Grid.Column="0" Content="🎙 ผสมเสียงไมค์จริงเข้าไปด้วย"
                              Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"
                              Margin="0,0,14,0" Checked="MicEnabled_Changed" Unchecked="MicEnabled_Changed"/>

                    <ComboBox x:Name="InputDeviceComboBox" Grid.Column="1" Width="260"
                              DisplayMemberPath="FriendlyName"
                              SelectionChanged="InputDeviceComboBox_SelectionChanged"/>

                    <TextBlock Grid.Column="2" Text="ระดับเสียงไมค์:" Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center" Margin="16,0,8,0"/>

                    <Slider x:Name="MicVolumeSlider" Grid.Column="3" Minimum="0" Maximum="2" Value="1"
                            VerticalAlignment="Center" ValueChanged="MicVolumeSlider_ValueChanged"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Status bar ล่าง -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource BgPanel}" Padding="16,8">
            <TextBlock x:Name="StatusText" Text="พร้อมใช้งาน — กด 'เพิ่มเสียง' เพื่อเริ่มต้น"
                       Foreground="{StaticResource TextSecondary}" FontSize="12"/>
        </Border>

        <!-- กริดปุ่มเสียง -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="SoundItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SoundCard}" Width="200">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimary}"
                                           FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding HotkeyDisplay}" Foreground="{StaticResource AccentBrush}"
                                           FontSize="12" Margin="0,2,0,10"/>

                                <Button Height="40" FontWeight="SemiBold"
                                        Click="PlayButton_Click" Tag="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource TopBarButton}">
                                            <Setter Property="Content" Value="▶ เล่น"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                    <Setter Property="Content" Value="⏹ หยุด"/>
                                                    <Setter Property="Background" Value="#E05252"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                    <Button Content="✏ แก้ไข" Style="{StaticResource IconButton}"
                                            Click="EditButton_Click" Tag="{Binding}" Margin="0,0,8,0"/>
                                    <Button Content="⌨ ตั้ง Hotkey" Style="{StaticResource IconButton}"
                                            Click="SetHotkey_Click" Tag="{Binding}" Margin="0,0,8,0"/>
                                    <Button Content="🗑 ลบ" Style="{StaticResource IconButton}"
                                            Click="DeleteButton_Click" Tag="{Binding}" Foreground="#E05252"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>
</Window>
