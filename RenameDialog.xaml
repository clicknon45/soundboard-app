<Window x:Class="SoundboardApp.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="แก้ไขชื่อ" Height="150" Width="360"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgDark}"
        ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="ชื่อปุ่มเสียง" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>
        <TextBox x:Name="NameTextBox" Padding="6" FontSize="14"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="ยกเลิก" Width="80" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="ตกลง" Width="80" Click="Ok_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
