<Application x:Class="SoundboardApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BgDark" Color="#1E1F26"/>
        <SolidColorBrush x:Key="BgPanel" Color="#2A2C36"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#5B8CFF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F1F2F6"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9AA0B4"/>
    </Application.Resources>
</Application>
